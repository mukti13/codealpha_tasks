before_covid = df[df["Date"] < "2020-03-01"]

during_covid = df[df["Date"] >= "2020-03-01"]

print("Average Unemployment Rate Before COVID:")
print(before_covid["Estimated Unemployment Rate (%)"].mean())

print("\nAverage Unemployment Rate During COVID:")
print(during_covid["Estimated Unemployment Rate (%)"].mean())

comparison = {
    "Before COVID": before_covid["Estimated Unemployment Rate (%)"].mean(),
    "During COVID": during_covid["Estimated Unemployment Rate (%)"].mean()
}

plt.figure(figsize=(6,5))

plt.bar(comparison.keys(), comparison.values())

plt.title("Average Unemployment Rate Before vs During COVID")

